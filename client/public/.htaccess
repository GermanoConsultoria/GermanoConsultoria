<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Força HTTPS (exceto validação do certificado SSL)
RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Arquivos e pastas que existem são entregues normalmente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Qualquer outra rota vai para o index.html (rotas do React)
RewriteRule ^ index.html [L]
</IfModule>
