# Arquivos gerados pelo Vite: o nome contém um hash do conteúdo (ex.: main-BA_bp0Vi.js).
# Quando o conteúdo muda, o nome muda, então o navegador pode guardá-los por 1 ano.
# O FilesMatch é necessário para esta regra valer também para as imagens: sem ele,
# a regra de imagens (7 dias) do .htaccess da raiz teria prioridade.
# Apagar este arquivo desfaz a regra.
<IfModule mod_headers.c>
<FilesMatch ".">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
